  "version": "1.0.0",
  "type": "module",
  "description": "Landing pages Hiperlink — Gestão em Tecnologia e PSG Dados — Políticas, Segurança e Governança de Dados",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
