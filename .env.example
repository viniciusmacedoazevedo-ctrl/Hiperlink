# Copie para .env e ajuste. O arquivo .env NÃO deve ser versionado.

# Usuário do painel /admin
ADMIN_USER=admin

# Senha do painel (use uma senha forte) — ou prefira o hash abaixo
ADMIN_PASSWORD=

# Alternativa mais segura: gere com  npm run admin:hash -- "sua senha"
# ADMIN_PASSWORD_HASH=

# Pasta onde ficam content.json e as imagens enviadas (padrão: ./data)
# DATA_DIR=data

# Porta do servidor de produção (npm start)
# PORT=3000
