# Copie para .env e ajuste. O arquivo .env NÃO deve ser versionado.

# Primeiro administrador do painel /admin.
# Só é usado quando o banco ainda não tem nenhum usuário (primeira execução).
# Depois disso, gerencie usuários pelo painel (Configurações → Usuários)
# ou com:  npm run admin:create -- --email voce@empresa.com.br --name "Seu nome"
ADMIN_NAME=Administrador
ADMIN_EMAIL=
# Mínimo de 10 caracteres. Em desenvolvimento, se ficar vazio, uma senha
# temporária é gerada e mostrada no terminal.
ADMIN_PASSWORD=

# Pasta do banco SQLite (hiperlink.db) e das imagens enviadas (padrão: ./data)
# Faça backup desta pasta.
# DATA_DIR=data

# Porta do servidor de produção (npm start)
# PORT=3000
